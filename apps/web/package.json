{
  "name": "@vexa/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build --webpack",
    "start": "next start",
    "test:agente-ui": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/agente/agente-ui.test.tsx",
    "test:pain-points": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/pain-points-ruta.test.ts tests/weekly-ruta.test.ts",
    "test:i18n": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/i18n.test.ts",
    "test:onboarding": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/onboarding.test.ts tests/onboarding-ui.test.tsx tests/onboarding-tour.test.tsx tests/setup.test.tsx",
    "test:auth": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/auth-http.test.ts",
    "test:cargador": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/member-file-loader.test.tsx",
    "test:cco": "node --require ./tests/server-only-stub.cjs --import tsx --test tests/cco.test.tsx",
    "test:sitio": "node --test \"tests/sitio/*.test.*\"",
    "presupuesto": "node ../../tools/sitio/presupuesto.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vexa/platform": "0.0.1",
    "pg": "8.16.3",
    "@vexa/notifications": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "@types/pg": "8.15.5"
  }
}
