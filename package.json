{
  "name": "vexa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "npm run test:kernel && npm run test:datos-cliente && npm run test:sitio",
    "test:sitio": "npm run test:sitio --workspace @vexa/web",
    "test:paquetes": "node --test --test-concurrency=2 \"packages/**/*.test.mjs\" \"apps/web/src/**/*.test.mjs\" \"scripts/**/test-*.mjs\" \"apps/web/tests/*.test.mjs\" \"tests/tooling/*.test.mjs\"",
    "test:web-ui": "npm run test:web-ui --workspace @vexa/web",
    "test:aceptacion": "node --test tests/acceptance/*.test.mjs",
    "typecheck": "npm run typecheck --workspace @vexa/web",
    "test:kernel": "node --test tests/acceptance/economics.test.mjs",
    "test:datos-cliente": "node --test tests/seguridad/datos-de-cliente.test.mjs",
    "test:mutations": "python3 scripts/probe_economics_mutations.py",
    "test:platform": "npm run test --workspace @vexa/platform",
    "test:cfo": "node --test packages/cfo-copilot/tests/*.test.mjs",
    "test:cco": "node --test packages/workspace-service/tests/insight-cco-pg.test.mjs packages/agent-datos/tests/cco-tools.test.mjs && npm run test:cco --workspace @vexa/web",
    "test:agent-datos": "node --test packages/agent-datos/tests/*.test.mjs",
    "test:metrics": "node --test packages/metrics/tests/*.test.mjs",
    "test:workspace-service": "node --test packages/workspace-service/tests/provenance.mjs packages/workspace-service/tests/trends.mjs packages/workspace-service/tests/coverage-exactas.test.mjs packages/workspace-service/tests/agregados.test.mjs packages/workspace-service/tests/resumen-sin-bloqueo.test.mjs packages/workspace-service/tests/problemas-sin-vinculos.test.mjs packages/workspace-service/tests/problemas-catalogo-resumen.test.mjs",
    "test:problems": "node --test packages/problems/tests/escala-lista.test.mjs packages/ai-scale/problemas/problemas.test.mjs"
  },
  "workspaces": [
    "apps/web",
    "packages/platform",
    "packages/notifications"
  ]
}
