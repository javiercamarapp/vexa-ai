{
  "name": "vexa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "npm run test:kernel && npm run test:foundation",
    "test:kernel": "node --test tests/acceptance/economics.test.mjs",
    "test:foundation": "node --test tests/acceptance/F00-*.test.mjs tests/acceptance/foundation-negative.test.mjs",
    "test:scaffold": "node --test tests/acceptance/F01-01.test.mjs",
    "test:all-gates": "node --test tests/acceptance/*.test.mjs",
    "guide:check": "python3 scripts/guide.py audit",
    "guide:render": "python3 scripts/guide.py render",
    "test:mutations": "python3 scripts/probe_economics_mutations.py",
    "test:controller": "python3 -m unittest discover -s tests/controller -v",
    "graph:check": "python3 orchestration/runner.py status",
    "test:business": "python3 -m unittest discover -s tests/business -v",
    "business:build": "python3 scripts/census_market.py && python3 scripts/business_model.py",
    "test:platform": "npm run test --workspace @vexa/platform"
  },
  "workspaces": [
    "apps/web",
    "packages/platform"
  ]
}
