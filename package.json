{
  "name": "vexa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "npm run test:kernel && npm run test:foundation",
    "test:kernel": "node --test tests/acceptance/economics.test.mjs",
    "test:foundation": "node --test tests/acceptance/F00-*.test.mjs tests/acceptance/foundation-negative.test.mjs",
    "test:scaffold": "node --test tests/acceptance/F01-01.test.mjs",
    "test:all-gates": "node --test tests/acceptance/*.test.mjs",
    "guide:check": "python3 scripts/guide.py audit",
    "guide:render": "python3 scripts/guide.py render",
    "test:mutations": "python3 scripts/probe_economics_mutations.py",
    "test:controller": "python3 -m unittest discover -s tests/controller -v",
    "graph:check": "python3 orchestration/runner.py status",
    "test:business": "python3 -m unittest discover -s tests/business -v",
    "business:build": "python3 scripts/census_market.py && python3 scripts/business_model.py",
    "test:platform": "npm run test --workspace @vexa/platform",
    "test:cfo": "node --test packages/cfo-copilot/tests/*.test.mjs",
    "test:agent-datos": "node --test packages/agent-datos/tests/*.test.mjs",
    "test:metrics": "node --test packages/metrics/tests/*.test.mjs",
    "test:workspace-service": "node --test packages/workspace-service/tests/provenance.mjs packages/workspace-service/tests/trends.mjs packages/workspace-service/tests/coverage-exactas.test.mjs packages/workspace-service/tests/agregados.test.mjs packages/workspace-service/tests/resumen-sin-bloqueo.test.mjs packages/workspace-service/tests/problemas-sin-vinculos.test.mjs",
    "test:problems": "node --test packages/problems/tests/escala-lista.test.mjs packages/ai-scale/problemas/problemas.test.mjs"
  },
  "workspaces": [
    "apps/web",
    "packages/platform",
    "packages/notifications"
  ]
}
