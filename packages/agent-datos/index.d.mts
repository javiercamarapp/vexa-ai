export type EpistemicClass = 'observed' | 'estimated' | 'inferred';
export type AgentRole = 'viewer' | 'operator' | 'analyst' | 'owner';
export type AnswerStatus = 'ok' | 'no_data' | 'clarify' | 'out_of_catalog' | 'rate_limited' | 'budget_exceeded' | 'unavailable' | 'invalid_input' | 'forbidden';
export type Coverage = { known_n: number; eligible_n: number | null; note?: string };
export type Figure = { id: string; label: string; display: string; value: number | string | null; class: EpistemicClass; coverage: Coverage; currency?: string; rank?: number };
export type BlockColumn = { key: string; label: string; kind: 'text' | 'integer' };
export type ChartSeries = { key: string; label: string; value: number | null; display: string; /** Mes con datos incompletos: se dibuja punteado y no es una caída. */ partial?: boolean };
export type Block = { tool: string; title: string; columns: BlockColumn[]; rows: Record<string, string | number | null>[]; chart?: { kind: 'bar' | 'line' | 'donut'; unit: string; additive?: boolean; series: ChartSeries[] }; class: EpistemicClass | 'mixed'; coverage: Coverage; truncated: boolean; note?: string };
export type Citation = { messageRevisionId: string; quote: string; role: string; source?: string; category?: string };
export type AnswerSource = { ref: string; label: string; href?: string; tool?: string };
export type CalcStep = { tool: string; label: string; status: string; args: Record<string, unknown>; method: string; reads: string[]; sources: AnswerSource[]; figures: number; durationMs?: number };
export type Usage = { modelCalls: number; toolCalls: number; costMinor: string; mode: string; fallback: boolean; guardRejected: boolean; durationMs?: number };
export type TraceStep = { id: string; kind: 'plan' | 'tool' | 'compose' | 'verify'; label: string; estado: string; ms: number | null; detail?: string; tool?: string; cifras?: number; fuentes?: string[]; args?: Record<string, unknown> };
export type Answer = { contractVersion?: number; trace?: TraceStep[]; status: AnswerStatus; text: string; figures: Figure[]; blocks: Block[]; citations: Citation[]; sources: AnswerSource[]; calc: CalcStep[]; missing: string[]; notes?: string[]; suggestions: string[]; usage: Usage; violations?: string[]; limit?: unknown };
export type Direct = { tool: string; args?: Record<string, unknown> };
export type AgentEvent = { t: 'paso'; fase: 'inicio' | 'fin'; herramienta: string; estado?: string; ms?: number | null; cifras?: number; fuentes?: string[] } | { t: 'traza'; paso: TraceStep };
export type SuggestionSet = { loaded: number; total: number; empty: boolean; sugerencias: string[]; categorias: { titulo: string; preguntas: string[] }[]; directas: Record<string, Direct> };
export type DataPort = { tenantId?: string; [method: string]: any };
export const LIMITS: Readonly<{ maxQuestionChars: number; maxHistory: number; maxHistoryTextChars: number; maxToolCallsPerTurn: number; maxModelCallsPerTurn: number; toolTimeoutMs: number; turnTimeoutMs: number; maxRowsPerBlock: number; maxTurnsPerConversation: number; maxCitations: number }>;
