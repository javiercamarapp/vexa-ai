export type EconomicEntry={id:string;rowId:string;revision:number;sourceId:string;externalId:string;kind:string;status:string;effectiveAt:string;recordedAt:string;currency:string;exponent:number;basis:string;amountMinor:string|null;orderId:string|null;reversalOf:string|null;report:string;actorId:string;details:Record<string,unknown>};
