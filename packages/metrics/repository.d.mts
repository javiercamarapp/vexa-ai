export type EconomicScope={start:string;end:string;timezone:string;dateBasis:'occurred_at';currency:string;exponent:number;basis:string};
export type SourceInput={sourceId?:string;expectedVersion:number;name:string;evidenceType:'order_export'|'payment_ledger'|'replacement_invoice'|'support_timesheet'|'scenario_assumption';active:boolean;complete:boolean;windowStart:string;windowEnd:string;watermark:string;report:string;attested:true};
export type EntryInput={sourceId:string;sourceVersion:number;expectedRevision:number;externalId:string;kind:'order'|'refund'|'reversal'|'replacement'|'support_model'|'future_scenario';effectiveAt:string;currency:string;exponent:number;basis:string;amountMinor:string|null;status:'recorded'|'settled'|'pending'|'cancelled'|'unknown'|'modeled';orderId:string|null;reversalOf:string|null;details:Record<string,unknown>;report:string;attested:true};
