export type Parte<T> = ({status: 'ok'} & T) | {status: 'empty' | 'unavailable'};
export type CanalIng = {canal: string; lineas: number; canceladas: number; activoMinor: string; canceladoMinor: string; desde: string; hasta: string; conSku: string; participacionPct: number | null; conSkuPct: number | null};
export type CalidadMes = 'completo' | 'parcial' | 'posible_hueco';
export type MesIng = {mes: string; totalMinor: string; canales: Record<string, {activoMinor: string; lineas: number; calidad: CalidadMes}>};
export type Crecimiento = {canal: string; mes: string; previo: string; activoMinor: string; previoMinor: string; pct: number};
export type SkuIng = {pos: number; sku: string; familia: string | null; lineas: number; canceladas: number; activoMinor: string; canceladoMinor: string; participacionPct: number | null; acumPct: number | null;
  canales: {canal: string; lineas: number; activoMinor: string}[]; crecimiento: Crecimiento | null};
export type FilaIntensidad = {sku: string; canal: string; reembolsos: number; reembolsoMinor: string; lineas: number; ingresoMinor: string; meses: number; intensidadPct: number | null; intensidadLineasPct: number | null; significativa: boolean};
export type Recomendacion = {id: string; tipo: 'revisar_proveedor' | 'empujar' | 'revisar_canal' | 'cross_sell'; sku: string | null; canal: string | null; titulo: string; accion: string; porque: string; evidencia: string[]; cobertura: string;
  impacto: {clase: 'observed' | 'estimated'; usdMinor: string | null; texto: string}; baseMinor: string};
export type FilaFamilia = {familia: string; etiqueta: string; skus: number; lineas: number; ingresoMinor: string; conversaciones: number; por100: number | null; posIngreso: number; posQuejas: number};
export type ProgresoIA = {v2: number; objetivo: number | null; avancePct: number | null; conFamilias: number; cargadas: number | null};
export type TrackerEstado = {n: number; nMonto: number; montoMinor: string};
export type BrechasVista = {
  generatedAt: string; currency: 'USD'; class: 'observed'; partes: Record<string, string>; frescura: Record<string, {refreshedAt: string | null; sourceWatermark: string | null; partial: boolean} | null>;
  umbrales: Record<string, number>;
  ingresos: Parte<{class: 'observed'; activoMinor: string; canceladoMinor: string; brutoConCanceladosMinor: string; lineas: number; canceladas: number; canceladasPct: number; revision: number; revisionMinor: string; sinSkuMinor: string; sinSkuPct: number | null;
    canales: CanalIng[]; rango: {desde: string; hasta: string}; otrasMonedas: {currency: string; exponent: number; lineas: number; activoMinor: string}[]; pares: Record<string, {previo: string; mes: string} | null>;
    meses: MesIng[]; calidad: {canal: string; mes: string; calidad: CalidadMes; lineas: number}[]}>;
  ranking: {status: 'ok' | 'empty' | 'unavailable'; items: SkuIng[]; total?: number; top10Pct?: number | null};
  crecimiento: {status: 'ok' | 'unavailable'; pares?: Record<string, {previo: string; mes: string} | null>; items: ({sku: string} & Crecimiento)[]};
  perdidas: {
    reembolsos: Parte<{class: 'observed'; n: number; canceladosN: number; sinMonto: number; brutoMinor: string; activoMinor: string; top10Pct: number | null; top10: string[]; canales: {canal: string; n: number; brutoMinor: string; activoMinor: string}[]; otrasMonedas: {currency: string; n: number}[]; inicioPorCanal: Record<string, string>}>;
    cancelaciones: Parte<{class: 'observed'; lineas: number; pct: number; canceladoMinor: string}>;
    tracker: Parte<{class: 'observed'; total: number; estados: Record<string, TrackerEstado>; negados: number; negadosMinor: string; negadosConMonto: number; supuestoMoneda: 'USD';
      motivos: {motivo: string; etiqueta: string; n: number; negados: number; reembolsados: number; negadosMinor: string}[]; canales: {canal: string; negados: number; negadosMinor: string}[]}>;
  };
  intensidad: {status: 'ok' | 'unavailable'; class?: 'observed'; filas: FilaIntensidad[]; medianaCanal?: Record<string, number>; cobertura?: {reembolsosCruzados: number; reembolsosTotales: number; usdCruzadoMinor: string; usdTotalMinor: string; pct: number | null}; nota?: string};
  concentracion: {status: 'ok' | 'unavailable'; top10Pct?: number | null; top10?: string[]; skusConReembolso?: number};
  familias: {status: 'pendiente' | 'parcial' | 'ok' | 'unavailable'; progreso: ProgresoIA | null; filas: FilaFamilia[]; sinMapa?: {familia: string; etiqueta: string; conversaciones: number}[]; categorias: {familia: string; etiqueta: string; conversaciones: number}[]; meses?: string[];
    cobertura?: {analizadas: number; conFamilia: number; conFamiliaPct: number | null; ingresoConMapaPct: number | null}};
  recomendaciones: {status: 'ok' | 'unavailable'; items: Recomendacion[]};
};
export type BorradorRecomendacion = {origen: 'brechas-de-ingreso'; clave: string; tipoBrecha: string; titulo: string; resumen: string; cuerpo: string; evidencia: string[]; cobertura: string;
  impacto: {clase: 'observed' | 'estimated'; usdMinor: string | null; texto: string}; supuestos: string[]; estadoSugerido: 'proposed'; etiquetas: string[]};
export const UMBRALES: Readonly<Record<string, number>>;
export const NOMBRE_CANAL: Readonly<Record<string, string>>;
export const MOTIVO_TRACKER: Readonly<Record<string, string>>;
