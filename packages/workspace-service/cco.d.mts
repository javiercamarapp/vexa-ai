export type EstadoCco = 'listo' | 'salvedad' | 'falta';
export type ClaseCco = 'observed' | 'estimated' | 'inferred';
export type Faltan = {clave: string; quien: 'responsable_a' | 'responsable_b'};
export type Cobertura = {clave: string; conocido: number; elegible: number | null; pct?: number | null};
export type CardBase = {id: 'A' | 'B' | 'C' | 'D' | 'E' | 'F'; estado: EstadoCco; clase: ClaseCco | null; fuente: 'libro' | 'tracker' | null; faltan: Faltan[]; salvedades: string[]; indisponible?: 'unavailable' | 'not_installed'; corte?: string | null; cobertura?: Cobertura[]};
export type FilaSku = {sku: string; lineas: number; brutoMinor: string; exponente: number; reembolsos: number | null; reembolsosSinImporte: number | null; reembolsoMinor: string | null; porCien: number | null; defectos: number | null; defectosClase: Record<string, number> | null; hojas: Record<string, number> | null};
export type MonedaCanal = {moneda: string; exponente: number; skus: number; totalBrutoMinor: string; top: FilaSku[]};
export type CanalA = {canal: string; ventana: {desde: string | null; hasta: string | null; meses: number; completa: boolean; ordenesDesde: string | null; ordenesHasta: string | null; devolucionesDesde: string | null; devolucionesHasta: string | null}; devolucionesDisponibles: boolean; lineas: number; lineasConSku: number; devoluciones: number | null; devolucionesConSku: number | null; lineasSinSku: number; monedas: MonedaCanal[]};
export type TarjetaAv = CardBase & {canales: CanalA[]; sinVentana?: string[]; trackerDisponible?: boolean; ventanasDistintas?: boolean};
export type FilaSinVenta = {sku: string; ultimoMes: string | null; mesesSinVenta: number; lineas9m: number; canales: string[]};
export type TarjetaBv = CardBase & {umbrales: {meses: number; skus: number}[]; top: Record<'3' | '6' | '9', FilaSinVenta[]> | never[]; total?: number; referencia?: string | null};
export type BodegaC = {bodega: string; latencia: Record<string, number>; motivos: Record<string, number>; total: number};
export type TarjetaCv = CardBase & {bodegas: BodegaC[]; ocultos?: number};
export type EstadoD = {clave: string; nombre: string; pais: 'US' | 'MX'; n: number; tipos: {etiqueta: string; n: number}[]; retailers: {etiqueta: string; n: number}[]};
export type TarjetaDv = CardBase & {estados: EstadoD[]; minimo?: number; ocultos?: {estados: number; casos: number; minimo: number} | null; pais?: {US: number; MX: number}; vacio?: boolean};
export type TarjetaEv = CardBase & {subcanales: {subcanal: string; n: number}[]};
export type TarjetaFv = CardBase & {noData: true};
export type CcoVista = {version: number; generatedAt: string; class: 'observed'; status: 'ok' | 'not_installed'; minimoPorCelda: number; resumen: {listo: number; salvedad: number; falta: number};
  cards: {A: TarjetaAv; B: TarjetaBv; C: TarjetaCv; D: TarjetaDv; E: TarjetaEv; F: TarjetaFv}};
export const K_MIN: number;
export const CCO_VERSION: number;
export const FALTAN: Record<string, Faltan[]>;
export const SUBCANALES: readonly string[];
export const BODEGAS: readonly string[];
export const LATENCIAS: readonly string[];
export const DEFECTOS: readonly string[];
export const HOJAS: readonly string[];
export function subcanalDe(raw: unknown): string;
export function baseDeSubcanal(c: string): string | null;
export function bodegaDe(raw: unknown): string | null;
export function latenciaDe(raw: unknown, bodega?: string | null): string | null;
export function defectoDe(reason: unknown, sub: unknown): string | null;
export function skuBaseDe(raw: unknown): string | null;
export function hojaDeTracker(sheet: string): string;
export function faltanDe(id: string): Faltan[];
export function armarCco(raw: unknown, geo: unknown, o?: {now?: Date}): CcoVista;
export function leerAgregadosCco(s: unknown, o: {deadline: number}): Promise<unknown>;
export function createCcoRepository(o: {database: unknown; now?: () => Date; budgets?: Record<string, number>}): {get(): Promise<CcoVista>; raw(): Promise<unknown>; geo(): Promise<unknown>};
export const FALTAN_ES: Readonly<Record<string, string>>;
export const QUIEN_ES: Readonly<Record<'responsable_a' | 'responsable_b', string>>;
export function faltanTexto(id: string): string[];
export function tarjetaA(raw: unknown): TarjetaAv;
export function tarjetaB(raw: unknown): TarjetaBv;
export function tarjetaC(raw: unknown): TarjetaCv;
export function tarjetaD(geo: unknown): TarjetaDv;
export function tarjetaE(raw: unknown): TarjetaEv;
export function tarjetaF(): TarjetaFv;
